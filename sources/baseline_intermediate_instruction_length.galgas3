//---------------------------------------------------------------------------------------------------

abstract func @baseline_intermediate_instruction length () -> @uint

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_NULL.length () -> @uint {
  result = 0
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_pseudo_PAGE.length () -> @uint {
  result = 0
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_pseudo_BEGIN_ROUTINE.length () -> @uint {
  result = 0
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_pseudo_END_ROUTINE.length () -> @uint {
  result = 0
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_pseudo_LABEL.length () -> @uint {
  result = 0
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_actualInstruction.length () -> @uint {
  result = 1
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_JUMP.length () -> @uint {
  result = 1 + (self.mCurrentPage ^ self.mTargetPage).oneBitCount
}

//---------------------------------------------------------------------------------------------------

override func @baseline_intermediate_JSR.length () -> @uint {
  result = 1 + 2 * (self.mCurrentPage ^ self.mTargetPage).oneBitCount
}

//---------------------------------------------------------------------------------------------------

override
func @baseline_intermediate_instruction_MNOP.length () -> @uint {
  result = self.mOccurrenceFactor.uint
}

//---------------------------------------------------------------------------------------------------


override func @baseline_intermediate_incDecRegisterInCondition.length () -> @uint {
  if self.mBranchIfZero then
    result = 3
  else
    result = 2
  end
}

//---------------------------------------------------------------------------------------------------

