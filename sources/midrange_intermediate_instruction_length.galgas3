

//----------------------------------------------------*

abstract func @midrange_intermediate_instruction instructionLength () -> @uint

//----------------------------------------------------*

override func @midrange_intermediate_NULL.instructionLength () -> @uint outLength {
  outLength = 0
}

//----------------------------------------------------*

override func @midrange_intermediate_pseudo_ORG.instructionLength () -> @uint outLength {
  outLength = 0
}

//----------------------------------------------------*

override func @midrange_intermediate_pseudo_LABEL.instructionLength () -> @uint outLength {
  outLength = 0
}

//----------------------------------------------------*

override func @midrange_intermediate_actualInstruction.instructionLength () -> @uint outLength {
  outLength = 1
}

//----------------------------------------------------*

override
func @midrange_intermediate_JUMP.instructionLength () -> @uint outLength {
  outLength = 1
  if self.mBit11 != @midrange_call_goto_bit. noChange then
    outLength += 1
  end
  if self.mBit12 != @midrange_call_goto_bit. noChange then
    outLength += 1
  end
}

//----------------------------------------------------*

override
func @midrange_intermediate_JSR.instructionLength () -> @uint outLength {
  outLength = 1
  if self.mBit11 != @midrange_call_goto_bit. noChange then
    outLength = outLength  + 2
  end
  if self.mBit12 != @midrange_call_goto_bit. noChange then
    outLength = outLength  + 2
  end
}

//----------------------------------------------------*

override
func @midrange_intermediate_instruction_MNOP.instructionLength () -> @uint outLength {
  outLength = self.mOccurrenceFactor.uint
}

//----------------------------------------------------*

override
func @midrange_intermediate_incDecRegisterInCondition.instructionLength () -> @uint outLength {
  if self.mBranchIfZero then
    outLength = 3
  else
    outLength = 2
  end
}

//----------------------------------------------------*

